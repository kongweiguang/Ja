# Cargo 生成的文件
# 包含已编译文件和可执行文件
/target/

# Tauri 生成的文件
# 包含用于 capability 自动补全的 schema 文件
/gen/schemas

# 原生 App Server 暂存目录由 scripts/native/stage-sidecar.py 重新生成；
# 源码树中只保留受版本控制的占位文件。
/sidecar-manifest.json
/sidecars/*
!/sidecars/.gitkeep
