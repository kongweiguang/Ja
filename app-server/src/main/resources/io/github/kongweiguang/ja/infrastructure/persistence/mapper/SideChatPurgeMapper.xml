    <select id="selectPurgeAttachmentIds" resultType="string">
        SELECT attachment_id FROM message_attachments
        WHERE message_id IN (
            SELECT message_id FROM messages
            <where>
                0
                <if test="threadIds != null and threadIds.size() > 0">
                    OR thread_id IN
