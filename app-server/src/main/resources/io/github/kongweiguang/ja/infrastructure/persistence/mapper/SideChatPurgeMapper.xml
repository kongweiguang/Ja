                </if>
            </where>
        )
        UNION
        SELECT attachment_id FROM pending_input_attachments
        WHERE input_id IN (
            SELECT input_id FROM pending_inputs
            <where>
                0
                <if test="threadIds != null and threadIds.size() > 0">
                    OR thread_id IN
                    <foreach item="threadId" collection="threadIds" open="(" separator="," close=")">#{threadId}</foreach>
