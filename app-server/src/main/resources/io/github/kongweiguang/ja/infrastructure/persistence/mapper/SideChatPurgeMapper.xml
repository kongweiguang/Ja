<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.kongweiguang.ja.infrastructure.persistence.mapper.SideChatPurgeMapper">
    <!-- Every mapper method below contains exactly one SQL statement. The Java caller snapshots all
         IDs before the first delete, so no delete re-expands thread_lineage after it starts. -->

    <select id="countClosingRoot" resultType="int">
        SELECT COUNT(*)
        FROM temporary_side_chats c
        JOIN threads t ON t.thread_id=c.thread_id
        WHERE c.thread_id=#{rootThreadId}
          AND c.state='CLOSING'
          AND t.deleted_at IS NULL
          AND EXISTS (
              SELECT 1 FROM thread_lineage l
              WHERE l.child_thread_id=c.thread_id
                AND l.task_kind='SIDE_TASK' AND l.lifecycle='INDEPENDENT'
          )
    </select>

    <select id="selectPurgeThreadIds" resultType="string">
        WITH RECURSIVE tree(thread_id,depth) AS (
            SELECT thread_id,0
            FROM temporary_side_chats
            WHERE thread_id=#{rootThreadId} AND state='CLOSING'
            UNION ALL
            SELECT l.child_thread_id,t.depth+1
            FROM thread_lineage l JOIN tree t ON l.parent_thread_id=t.thread_id
        )
        SELECT thread_id FROM tree ORDER BY depth,thread_id
    </select>

    <insert id="markPurgeThreadsClosing">
        INSERT INTO temporary_side_chats(thread_id,state)
        SELECT thread_id,'CLOSING' FROM threads
        WHERE 0
        <if test="threadIds != null and threadIds.size() > 0">
            OR thread_id IN
            <foreach item="threadId" collection="threadIds" open="(" separator="," close=")">#{threadId}</foreach>
        </if>
        ON CONFLICT(thread_id) DO UPDATE SET state='CLOSING'
    </insert>

    <select id="countNonTerminalTurns" resultType="int">
        SELECT COUNT(*) FROM turns
        WHERE 0
        <if test="threadIds != null and threadIds.size() > 0">
            OR (thread_id IN
            <foreach item="threadId" collection="threadIds" open="(" separator="," close=")">#{threadId}</foreach>
            AND state NOT IN ('COMPLETED','FAILED','CANCELLED'))
        </if>
    </select>

    <select id="selectPurgeTurnIds" resultType="string">
        SELECT turn_id FROM turns
        WHERE 0
        <if test="threadIds != null and threadIds.size() > 0">
            OR thread_id IN
            <foreach item="threadId" collection="threadIds" open="(" separator="," close=")">#{threadId}</foreach>
        </if>
        ORDER BY turn_sequence
    </select>

