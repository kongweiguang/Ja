                    OR turn_id IN
                    <foreach item="turnId" collection="turnIds" open="(" separator="," close=")">#{turnId}</foreach>
                </if>
            </where>
        )
        ORDER BY attachment_id
    </select>

    <update id="discardPurgeAttachments">
        UPDATE attachments
        SET status='DISCARDED', discarded_at=#{discardedAt}, blob_sha256=NULL, bound_at=NULL
        WHERE 0
        <if test="attachmentIds != null and attachmentIds.size() > 0">
            OR (
                status IN ('DRAFT','BOUND')
                AND attachment_id IN
                <foreach item="attachmentId" collection="attachmentIds" open="(" separator="," close=")">#{attachmentId}</foreach>
                AND NOT EXISTS (
                    SELECT 1 FROM message_attachments ma WHERE ma.attachment_id=attachments.attachment_id
                )
                AND NOT EXISTS (
                    SELECT 1 FROM pending_input_attachments pia WHERE pia.attachment_id=attachments.attachment_id
                )
                AND NOT EXISTS (
                    SELECT 1
                    FROM task_context_seeds s, json_each(s.references_json) ref
                    WHERE json_extract(ref.value,'$.kind')='attachment'
                      AND json_extract(ref.value,'$.attachmentId')=attachments.attachment_id
                )
            )
        </if>
    </update>

