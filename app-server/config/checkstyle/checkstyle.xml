<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8" />
    <property name="severity" value="error" />

    <!-- 作者必须位于首行，避免许可证或 package 声明把所有权信息隐藏到文件中部。 -->
    <module name="RegexpHeader">
        <property name="header" value="// @author kongweiguang" />
    </module>

    <module name="TreeWalker">
        <module name="AvoidStarImport" />
        <module name="UnusedImports" />
        <module name="MissingJavadocType">
            <property name="scope" value="private" />
            <property name="tokens" value="CLASS_DEF,INTERFACE_DEF,ENUM_DEF,RECORD_DEF,ANNOTATION_DEF" />
        </module>
        <module name="MissingJavadocMethod">
            <property name="scope" value="private" />
            <property name="minLineCount" value="0" />
            <property name="allowMissingPropertyJavadoc" value="false" />
            <property name="tokens" value="METHOD_DEF,CTOR_DEF,ANNOTATION_FIELD_DEF,COMPACT_CTOR_DEF" />
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="\b(class|interface|record|enum)\s+\w*(Utils|Helper|Manager)\b" />
            <property name="message" value="类型名必须表达业务职责，禁止 Utils、Helper 或 Manager。" />
            <property name="ignoreComments" value="true" />
        </module>
    </module>
</module>
