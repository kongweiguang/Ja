<FindBugsFilter>
    <!-- 当前不建立历史 baseline；只有带中文技术原因的精确 bug pattern/class 才能加入。 -->

    <!-- 关闭与 deadline 边界必须原样传播分类后的运行时失败，不能吞掉资源根因。 -->
    <Match><Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/><Class name="io.github.kongweiguang.ja.agent.application.service.AgentEngineService"/><Method name="awaitClosed"/></Match>
    <Match><Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/><Class name="io.github.kongweiguang.ja.agent.shared.DeadlineBudget"/><Method name="await"/></Match>
    <!-- 基础设施 codec 与其 application.gateway 合同必须保持领域术语一致。 -->
    <Match><Bug pattern="NM_SAME_SIMPLE_NAME_AS_INTERFACE"/><Class name="io.github.kongweiguang.ja.agent.infrastructure.persistence.ExtensionFactRecordCodec"/></Match>
    <Match><Bug pattern="NM_SAME_SIMPLE_NAME_AS_INTERFACE"/><Class name="io.github.kongweiguang.ja.agent.infrastructure.persistence.MiddlewareStateRecordCodec"/></Match>

    <!-- 两种 Store 初始化只执行各自模块内固定版本的 classpath DDL；无调用方 SQL 输入。 -->
    <Match>
        <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
        <Or>
            <Class name="io.github.kongweiguang.ja.agent.store.local.infrastructure.SQLiteAgentStore"/>
            <Class name="io.github.kongweiguang.ja.agent.store.pg.infrastructure.PostgresAgentStore"/>
        </Or>
        <Method name="initializeSchema"/>
    </Match>
    <!-- 写入先回滚后原样重抛已分类失败，读取和回执写入保留冲突/不可用的具体异常身份。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Or>
            <Class name="io.github.kongweiguang.ja.agent.store.local.infrastructure.SQLiteAgentStore"/>
            <Class name="io.github.kongweiguang.ja.agent.store.pg.infrastructure.PostgresAgentStore"/>
        </Or>
        <Method name="~(write|read|insertOperationReceiptUnchecked)"/>
    </Match>
    <!-- Skill schema 仅迭代私有固定 DDL 数组；分页只在两条编译期常量 SQL 间选择，所有值独立绑定。 -->
    <Match>
        <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
        <Class name="io.github.kongweiguang.ja.agent.skills.pg.infrastructure.PostgresSkillSchema"/>
        <Method name="install"/>
    </Match>
    <Match>
        <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
        <Class name="io.github.kongweiguang.ja.agent.skills.pg.infrastructure.PostgresSkillSource"/>
        <Method name="readPage"/>
    </Match>
    <!-- 生命周期边界保留首要关闭异常的身份，调用方据此区分超时、取消和真实释放失败。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.bootstrap.RuntimeResourceLifecycle"/>
        <Method name="~(awaitCompletion|closeOwnedResources|closeWithinDeadline)"/>
    </Match>
    <!-- MCP 的序列化调用与限时初始化必须先释放临时资源，再透传原始取消或端口失败。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.catalog.adapter.out.mcp.runtime.McpRuntime"/>
        <Method name="~(initializeSessions|invokeSerialized)"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.catalog.adapter.out.mcp.runtime.McpRuntimeLifecycle"/>
        <Method name="executeServerWithin"/>
    </Match>
    <!-- 工具短租约绑定失败后原样重抛，不能把资源失败改成新的模型或存储类别。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.bootstrap.runtime.ConfigurationTurnRuntimeResolver"/>
        <Method name="~lambda\$toolSessions\$[0-9]+"/>
    </Match>
    <!-- 凭据读取在唯一边界分类；已分类异常保持身份，正文不进入公开错误消息。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.configuration.adapter.out.security.windows.CredentialStore"/>
        <Method name="load"/>
    </Match>
    <!-- 队列只映射已确认的冲突或容量错误，未知存储失败不能伪装成未找到或队列已满。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.conversation.application.service.TurnService"/>
        <Method name="~(enqueueTaskMessage|mutate)"/>
    </Match>
    <!-- 两个短租约保留 unchecked 关闭原因，只有 checked 关闭失败才包装为状态异常。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.conversation.application.title.AutomaticThreadTitleScheduler$RequestRuntime"/>
        <Method name="close"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.conversation.port.out.RuntimeLease"/>
        <Method name="close"/>
    </Match>
    <!-- 受理失败先解除本次运行登记，再透传已分类原因供唯一 RPC 错误映射处理。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.transport.rpc.handler.TurnApprovalHandler"/>
        <Method name="~(continueQuestion|reask|respond|resume|startCurrent|lambda\$respond\$[0-9]+)"/>
    </Match>
    <!-- 连接、运行时与观察资源只有一个 owner；清理失败必须沿关闭调用链保留。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.transport.rpc.runtime.RpcServer"/>
        <Method name="closeOwnedConnection"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.transport.rpc.runtime.RpcSession"/>
        <Method name="~(beginShutdown|closeOwnedRuntime|observeInteraction|observePlan)"/>
    </Match>

    <!-- 进程退出先逐个关闭 owner，后续故障作为 suppressed；首要关闭异常必须保留原身份。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.bootstrap.RecoverableRuntimeBootstrap"/>
        <Method name="close" params="io.github.kongweiguang.ja.agent.application.concurrent.ShutdownDeadline" returns="void"/>
    </Match>
    <!-- 本次交接的取消 hook 和 runtime 均先尝试关闭；已分类故障原样返回以支持下次继续清理。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.conversation.application.service.TurnService"/>
        <Method name="throwCloseFailure" params="java.lang.Throwable" returns="void"/>
    </Match>
    <!-- Turn 成功也必须等待 ledger 结算；ledger 的首要故障保持原身份，不能报告虚假的业务完成。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.plan.application.PlanExecutionTurnAdapter"/>
        <Method name="~lambda\$settleCompletion\$[0-9]+" params="java.lang.Runnable,java.lang.Object,java.lang.Throwable" returns="java.lang.Void"/>
    </Match>
    <!-- wait 准入失败先撤销 waiter 与 timer，再同步重抛原故障；异步失败会改变未受理语义。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.collaboration.application.TaskCoordinator"/>
        <Method name="waitAgents" params="java.util.Set,java.time.Duration,io.github.kongweiguang.ja.agent.domain.concurrent.CancellationToken" returns="java.util.concurrent.CompletionStage"/>
    </Match>
    <!-- 两个事务入口先整体回滚并关闭 session；已分类的 Store/Plan 故障保持原实例与错误类别。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.plan.adapter.out.persistence.PlanUnitOfWork"/>
        <Method name="required" params="io.github.kongweiguang.ja.plan.adapter.out.persistence.PlanUnitOfWork$Work" returns="java.lang.Object"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.plan.adapter.out.persistence.PlanUnitOfWork"/>
        <Method name="solonTransaction" params="org.apache.ibatis.session.SqlSessionFactory,io.github.kongweiguang.ja.plan.adapter.out.persistence.PlanUnitOfWork$Work" returns="java.lang.Object"/>
    </Match>
    <!-- 占位符数量只取自私有固定 Goal 拒绝清单；全部名称独立 setString，调用方无法输入 SQL。 -->
    <Match>
        <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
        <Class name="io.github.kongweiguang.ja.infrastructure.persistence.database.JaDatabase"/>
        <Method name="hasRemovedGoalSchema" params="org.sqlite.SQLiteDataSource" returns="boolean"/>
    </Match>
    <!-- JDK 25 record pattern 在 PC 287/514 将 accessor 值经合成 slot 23 转存到真实绑定；
         LVT 的源码变量 kind 只覆盖 PC 383..424。仅排除此方法无源码名称的临时 store，保留具名 DLS。 -->
    <Match>
        <Bug pattern="DLS_DEAD_LOCAL_STORE"/>
        <Class name="io.github.kongweiguang.ja.infrastructure.persistence.store.JaTransactionParticipant"/>
        <Method name="applyMessages" params="java.sql.Connection,io.github.kongweiguang.ja.agent.application.gateway.store.JdbcTransactionContext,java.util.Map,java.util.Set,io.github.kongweiguang.ja.agent.domain.execution.ExecutionEvent$Terminal" returns="void"/>
        <Local name="?"/>
    </Match>
    <!-- 装配失败仍须关闭每个临时输入；首要故障与 suppressed 清理诊断不能重新分类或丢失。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.bootstrap.runtime.ConfigurationTurnRuntimeResolver"/>
        <Method name="closeRuntimeInputs" params="java.lang.Throwable,java.lang.AutoCloseable[]" returns="void"/>
    </Match>
    <!-- Gateway 获取失败先归还 reservation；快照关闭逐项释放租约，失败由唯一资源 owner 处理。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.catalog.adapter.out.mcp.generation.GenerationTurnMcpSessionFactory$CatalogSnapshot"/>
        <Method name="openGateway" params="com.fasterxml.jackson.databind.ObjectMapper,java.util.function.BooleanSupplier" returns="io.github.kongweiguang.ja.catalog.adapter.out.mcp.generation.SharedMcpGateway"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.catalog.adapter.out.mcp.generation.GenerationTurnMcpSessionFactory$CatalogSnapshot"/>
        <Method name="close" params="" returns="void"/>
    </Match>
    <!-- FFM Arena 关闭失败必须传回 Win32 句柄 owner，不能把未释放资源当作关闭成功。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.platform.windows.WindowsKernel32Library"/>
        <Method name="close" params="" returns="void"/>
    </Match>
    <!-- shutdown 尝试取消全部 compaction，汇总首因交给连接 owner；后续关闭继续执行。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.transport.rpc.handler.ThreadCompactionHandler"/>
        <Method name="cancelForShutdown" params="" returns="void"/>
    </Match>
    <!-- 写失败先以相同原因结束 active/control/data 帧，writer owner 随后退出并报告清理结果。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.transport.rpc.runtime.StdioWriter"/>
        <Method name="write" params="io.github.kongweiguang.ja.transport.rpc.runtime.StdioWriter$Frame" returns="void"/>
    </Match>
    <!-- 侧聊身份参与跨平台 system prompt 和 revision；固定 LF 是协议内容，不能替换为宿主换行。 -->
    <Match>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
        <Class name="io.github.kongweiguang.ja.bootstrap.runtime.ConfigurationTurnRuntimeResolver"/>
        <Method name="sideTaskIdentityPrompt" params="io.github.kongweiguang.ja.conversation.port.out.TaskCapabilityCeilingPort$RuntimeIdentity" returns="java.lang.String"/>
    </Match>

    <!-- Core 已从 conversation 迁至 agent；这些具体重抛点保留关闭、取消和 Store 失败的原始运行时身份。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.application.api.AgentEngine"/>
        <Method name="awaitClosed"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.application.cancellation.DefaultCancellationCoordinator"/>
        <Method name="throwIfCloseFailed"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.application.concurrent.ShutdownDeadline"/>
        <Method name="await"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.application.context.summary.ModelSummaryGenerator"/>
        <Method name="openRuntime"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.application.context.summary.ModelSummaryGenerator"/>
        <Method name="summarize"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.application.context.summary.ModelSummaryGenerator$RequestRuntime"/>
        <Method name="close"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.application.engine.AgentEventWatchRegistry"/>
        <Method name="watch"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.application.loop.AgentExecutionSession"/>
        <Method name="consumeInput"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.application.loop.AgentExecutionSession"/>
        <Method name="drive"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.application.loop.AgentRound"/>
        <Method name="onEvent"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.application.loop.DeltaTimerScheduler$TimerHandle"/>
        <Method name="schedule"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.application.loop.StandardAgentLoopExecutionService"/>
        <Method name="mutateInput"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.application.gateway.AgentRequestRuntime"/>
        <Method name="close"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.application.gateway.AgentTool$SettlementResource"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.infrastructure.model.ModelAdapterFactory"/>
        <Method name="start"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.infrastructure.model.shared.AbstractStreamingModelAdapter"/>
        <Method name="executeHttp"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.infrastructure.model.shared.AbstractStreamingModelAdapter"/>
        <Method name="submit"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.infrastructure.model.shared.ModelTransport"/>
        <Method name="awaitClose"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.infrastructure.model.shared.RequestController"/>
        <Method name="beginSink"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.infrastructure.model.shared.RequestController"/>
        <Method name="bindCall"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.infrastructure.model.shared.RequestController"/>
        <Method name="bindStream"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.agent.infrastructure.model.summary.HttpSummaryModel"/>
        <Method name="executeBounded"/>
    </Match>

    <!-- 私有 MCP 捕获的短租约必须先逐项关闭，再原样重抛原异常。 -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.catalog.adapter.out.mcp.generation.GenerationCatalog"/>
        <Method name="capture"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
        <Class name="io.github.kongweiguang.ja.catalog.adapter.out.mcp.generation.GenerationTurnMcpSessionFactory"/>
        <Method name="catalog"/>
    </Match>

    <!-- AbstractExecutorService 的 nullable 默认注解弱于本实现的显式 fail-fast 契约，两个 override 必须拒绝 null。 -->
    <Match>
        <Bug pattern="NP_PARAMETER_MUST_BE_NONNULL_BUT_MARKED_AS_NULLABLE"/>
        <Class name="io.github.kongweiguang.ja.agent.application.concurrent.BoundedVirtualExecutor"/>
        <Method name="~(execute|newTaskFor)"/>
    </Match>

    <!-- 下列 record 在构造时使用 List.copyOf、不可修改 Map 或递归 JSON 冻结，返回引用本身不可变。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="~io\.github\.kongweiguang\.ja\.(catalog\.adapter\.out\.mcp\.support\.McpServerDefinition|configuration\.adapter\.out\.generation\.ConfigGeneration\$Profile)"/>
    </Match>

    <!-- Core record 与嵌套命令在构造时复制集合或冻结 JSON；列表中的类型是唯一被审计的数据载体。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="~io\.github\.kongweiguang\.ja\.agent\.(application\.api\.engine\.(AgentCompactionRequest|AgentInputCommand\$(Delete|Enqueue|Prioritize|Update)|AgentInternalRequest|AgentRequest)|application\.engine\.AgentRequestBinding|application\.loop\.(AgentExecutionBinding|AgentExecutionRequest(\$HistorySelection)?|AgentInputMutation)|domain\.context\.SummaryDocument|domain\.conversation\.AgentInputQueue\$Command|domain\.execution\.ExecutionEvent\$(ModelCompleted|WaitResolved)|domain\.interaction\.InteractionAnswerSubmission|domain\.model\.ModelMessage|application\.gateway\.AgentMiddleware\$(RequestContext|RequestPatch)|application\.gateway\.AgentTool\$ExecutionContext|application\.gateway\.ModelPort\$ModelRequest)"/>
    </Match>

    <!-- 这些核心类型有意暴露生命周期端口或同一 JDBC 事务连接，不能复制，否则破坏宿主 ownership 或原子性。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~io\.github\.kongweiguang\.ja\.agent\.(application\.gateway\.AgentRequestRuntime|application\.gateway\.store\.(JdbcConversationTransactionContext|JdbcTransactionContext))"/>
    </Match>

    <!-- 这些既有 Ja 类型仍借用组合根或平台资源；其配置、数据库与连接生命周期由原有 owner 管理。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~io\.github\.kongweiguang\.ja\.(bootstrap\.SolonRuntimeComposition|bootstrap\.runtime\.ConfigurationTurnRuntimeResolver\$1|configuration\.adapter\.out\.generation\.ConfigGeneration\$Lease|infrastructure\.persistence\.database\.JaDatabase|platform\.windows\.WindowsNativeProcess|transport\.rpc\.RpcServiceBindings)"/>
    </Match>

    <!-- ObjectMapper、MyBatis Mapper proxy 与 RpcSession 都是组合根、事务或连接生命周期注入的 owner；
         跨职责子包只借用它们，不允许复制、替换或延长资源生命周期。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~io\.github\.kongweiguang\.ja\.(configuration\.adapter\.out\.security\.windows\.CredentialStore|infrastructure\.persistence\.mapper\.PersistenceMappers|transport\.rpc\.(handler\.(ConfigurationHandler|HandshakeHandler|HealthShutdownHandler|SettingsCatalogHandler|ThreadHistoryHandler|TurnApprovalHandler|WorkspaceHandler)|runtime\.RpcSession))"/>
    </Match>

    <!-- 注册表和目录映射均由同一监视器保护；锁外关闭 WatchService 与 take 并发，
         目的是唤醒阻塞的 watcher。豁免只覆盖已核实的五个访问边界。 -->
    <Match>
        <Bug pattern="AT_UNSAFE_RESOURCE_ACCESS_IN_THREAD"/>
        <Class name="io.github.kongweiguang.ja.configuration.adapter.out.document.ConfigurationWatcher"/>
        <Method name="~(closeWatchServiceQuietly|processWatchKey|registerDirectory|removeWatchRegistration|watchLoop)"/>
    </Match>

    <!-- 私有校验函数由同文件嵌套 record 的 compact constructor 或匿名实现调用，SpotBugs 未归因该字节码调用。 -->
    <Match>
        <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
        <Class name="io.github.kongweiguang.ja.agent.application.api.engine.AgentInputCommand"/>
        <Method name="~(requireEntryRevision|freezeMetadata)"/>
    </Match>
    <Match>
        <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
        <Class name="io.github.kongweiguang.ja.agent.domain.execution.ExecutionEvent"/>
        <Method name="~(id|ids)"/>
    </Match>
    <Match>
