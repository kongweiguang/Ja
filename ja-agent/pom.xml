<?xml version="1.0" encoding="UTF-8"?>
<!-- @author kongweiguang -->
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.kongweiguang</groupId>
    <artifactId>ja-parent</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>
    <name>Ja Java Modules</name>
    <modules>
        <module>ja-agent-core</module>
        <module>extensions/ja-agent-store-local</module>
        <module>extensions/ja-agent-store-pg</module>
        <module>extensions/ja-agent-skills-local</module>
        <module>extensions/ja-agent-skills-pg</module>
        <module>example</module>
        <module>ja-app-server</module>
    </modules>
    <properties>
        <!-- JVM 与 Native Image 共用 Java 25 ABI 和同一组合根。 -->
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 相对于各模块设置目录，使同一个 Maven 用户属性为各模块创建独立目标目录。 -->
        <ja.build.directory>target</ja.build.directory>
        <!-- 以 Maven reactor 的父聚合目录锚定共享质量配置，不依赖启动时的工作目录。 -->
        <ja.agent.root>${session.executionRootDirectory}</ja.agent.root>

        <jackson.version>2.22.2</jackson.version>
        <jackson3.version>3.2.2</jackson3.version>
        <tomlj.version>1.1.1</tomlj.version>
        <kotlin.version>2.4.10</kotlin.version>
        <flyway.version>13.4.0</flyway.version>
        <mcp.version>2.0.1</mcp.version>
        <networknt.version>3.0.7</networknt.version>
        <okhttp.version>5.5.0</okhttp.version>
        <okio.version>3.18.1</okio.version>
        <reactor.version>3.8.7</reactor.version>
        <mybatis.version>3.5.19</mybatis.version>
        <slf4j.version>2.0.18</slf4j.version>
        <logback.version>1.6.3</logback.version>
        <sqlite.version>3.53.4.0</sqlite.version>
        <junit.version>6.1.3</junit.version>
        <mockwebserver.version>5.5.0</mockwebserver.version>
        <jazzer.version>0.30.0</jazzer.version>
        <eggg.version>1.1.5</eggg.version>
        <archunit.version>1.5.0</archunit.version>
        <checkstyle.version>14.0.0</checkstyle.version>
        <pmd.version>7.26.0</pmd.version>

        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <native-maven-plugin.version>1.1.10</native-maven-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <spotbugs-maven-plugin.version>4.10.4.0</spotbugs-maven-plugin.version>
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <postgresql.version>42.7.11</postgresql.version>
        <spring-boot.version>4.0.4</spring-boot.version>
        <embedded-postgres.version>2.2.2</embedded-postgres.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- 协议与模型代码共用同一 Jackson 2 版本线，MCP 映射器也显式使用该版本。 -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- OkHttp 5 基于 Kotlin；固定运行时版本线，确保 Native 和 JVM 使用同一 ABI。 -->
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-bom</artifactId>
                <version>${kotlin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Solon 4.1.0 及其 YAML 依赖栈声明了相邻的 eggg 补丁版本；统一使用 core 选定的版本。 -->
            <dependency>
                <groupId>org.noear</groupId>
                <artifactId>eggg</artifactId>
                <version>${eggg.version}</version>
            </dependency>
            <!-- MCP SDK 仍传递声明旧验证器；运行时统一当前 ABI，并把 Schema 校验封装在 Tool Adapter。 -->
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${networknt.version}</version>
            </dependency>
            <!-- Flyway 13 与 NetworkNT 3 同时使用 Jackson 3；统一当前正式 ABI，避免类路径近路选择。 -->
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${jackson3.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson3.version}</version>
            </dependency>
            <!-- MCP SDK 仍声明 Reactor 3.7；由应用统一到已验证的当前正式 ABI。 -->
            <dependency>
                <groupId>io.projectreactor</groupId>
                <artifactId>reactor-core</artifactId>
                <version>${reactor.version}</version>
            </dependency>
            <!-- Solon 插件只负责装配，领域持久化适配器统一使用当前 MyBatis ABI。 -->
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
            <!-- 日志 API 与 Provider 必须成套收敛，避免 Solon 传递版本近路覆盖生产版本。 -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-core</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <!-- OkHttp 与 MCP 都会传递 Okio；统一 JVM 实现以保证 Native/JVM 类路径一致。 -->
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio-jvm</artifactId>
                <version>${okio.version}</version>
            </dependency>
            <!-- 只有扩展模块契约测试会启动真实 PostgreSQL。 -->
            <dependency>
                <groupId>io.zonky.test</groupId>
                <artifactId>embedded-postgres</artifactId>
                <version>${embedded-postgres.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <directory>${project.basedir}/${ja.build.directory}</directory>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration><release>25</release><parameters>true</parameters></configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <failIfNoTests>false</failIfNoTests>
                        <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                        <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <configuration>
                    <rules>
                        <requireJavaVersion><version>[25,26)</version></requireJavaVersion>
                        <requireReleaseDeps>
                            <message>Ja requires release-only dependencies; snapshots and ranges are forbidden.</message>
                            <failWhenParentIsSnapshot>true</failWhenParentIsSnapshot>
                        </requireReleaseDeps>
                        <dependencyConvergence />
                        <bannedDependencies>
                            <excludes>
                                <exclude>io.modelcontextprotocol.sdk:mcp</exclude>
                                <exclude>io.modelcontextprotocol.sdk:mcp-json-jackson3</exclude>
                                <exclude>com.openai:openai-java-core</exclude>
                                <exclude>com.openai:openai-java</exclude>
                                <exclude>com.openai:openai-java-client-okhttp</exclude>
                                <exclude>com.anthropic:anthropic-java-core</exclude>
                                <exclude>com.anthropic:anthropic-java</exclude>
                                <exclude>com.anthropic:anthropic-java-client-okhttp</exclude>
                            </excludes>
                            <message>Ja owns Provider wire codecs and one composition-owned OkHttp transport.</message>
                        </bannedDependencies>
                    </rules>
                    <fail>true</fail>
                </configuration>
                <executions>
                    <execution>
                        <id>enforce-build-baseline</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${ja.agent.root}/config/checkstyle/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <failOnViolation>true</failOnViolation>
                    <consoleOutput>true</consoleOutput>
                    <cacheFile>${project.build.directory}/checkstyle-cachefile</cacheFile>
                </configuration>
                <executions>
                    <execution>
                        <id>check-java-source-policy</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <failOnError>true</failOnError>
                    <excludeFilterFile>${ja.agent.root}/config/spotbugs/exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${maven-pmd-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetJdk>${java.version}</targetJdk>
                    <rulesets><ruleset>${ja.agent.root}/config/pmd/ja-ruleset.xml</ruleset></rulesets>
                    <!-- 身份派生的固定前缀与十六进制编码存在短模板重复；避免把低于百 token 的原语误报为业务复制。 -->
                    <minimumTokens>100</minimumTokens>
                    <failOnViolation>true</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                    <!-- 两个限界上下文各自保留同一协议校验边界，避免跨上下文依赖形成环；CPD 不应强迫它们共享实现。 -->
                    <excludes>
                        <exclude>**/catalog/infrastructure/mcp/validation/NetworkntToolArgumentValidator.java</exclude>
                        <exclude>**/conversation/infrastructure/tools/NetworkntToolArgumentValidator.java</exclude>
                    </excludes>
                    <excludeRoots>
                        <excludeRoot>${project.build.directory}/generated-sources</excludeRoot>
                    </excludeRoots>
                </configuration>
                <executions>
                    <execution>
                        <id>pmd-and-cpd-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal><goal>cpd-check</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
