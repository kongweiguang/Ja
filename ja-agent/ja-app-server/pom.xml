<?xml version="1.0" encoding="UTF-8"?>
<!-- @author kongweiguang -->
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.kongweiguang</groupId>
        <artifactId>ja-parent</artifactId>
        <version>0.2.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>io.github.kongweiguang</groupId>
    <artifactId>ja-app-server</artifactId>
    
    <packaging>jar</packaging>

    <name>Ja App Server</name>
    <description>Local app server and native Agent Kernel for the Ja desktop</description>
    <licenses>
        <license>
            <name>GNU General Public License v3.0 or later</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <!-- 应用专属输出和入口类不会泄漏到可复用产物中。 -->
        <solon.version>4.1.0</solon.version>
        <ja.app-server.build.directory>${project.basedir}/${ja.build.directory}</ja.app-server.build.directory>
        <ja.main.class>io.github.kongweiguang.ja.bootstrap.App</ja.main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.kongweiguang</groupId>
            <artifactId>ja-agent-store-local</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency><groupId>io.github.kongweiguang</groupId><artifactId>ja-agent-skills-local</artifactId><version>${project.version}</version></dependency>
        <dependency>
            <groupId>io.github.kongweiguang</groupId>
            <artifactId>ja-agent-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Core 测试支撑只进入 App Server 测试 classpath，不随应用运行时发布。 -->
        <dependency>
            <groupId>io.github.kongweiguang</groupId>
            <artifactId>ja-agent-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- 配置、进程生命周期和 FeatHTTP WebSocket 监听器均由 Solon 管理。 -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon</artifactId>
            <version>${solon.version}</version>
        </dependency>
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-java25</artifactId>
            <version>${solon.version}</version>
        </dependency>
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-server-feathttp</artifactId>
            <version>${solon.version}</version>
        </dependency>
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-net</artifactId>
            <version>${solon.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.smartboot.socket</groupId>
            <artifactId>aio-core</artifactId>
            <version>2.1.3</version>
        </dependency>
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-config-yaml</artifactId>
            <version>${solon.version}</version>
        </dependency>
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-logging-logback-jakarta</artifactId>
            <version>${solon.version}</version>
        </dependency>
        <!-- 最终的 MyBatis 组合与事务生命周期由 Solon 管理；第一阶段已在 Windows Native Image 中验证了这套依赖组合。 -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-data</artifactId>
            <version>${solon.version}</version>
        </dependency>
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>mybatis-solon-plugin</artifactId>
            <version>${solon.version}</version>
        </dependency>

        <!-- 适配器边界显式使用 JSON；其版本不由 Provider SDK 控制。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <!-- Ja App Server 负责 config.toml，并在凭据边界使用当前严格 TOML 解析器，避免维护不完整的手写语法解析器。 -->
        <dependency>
            <groupId>org.tomlj</groupId>
            <artifactId>tomlj</artifactId>
            <version>${tomlj.version}</version>
        </dependency>

        <!-- MCP 2.0.1 显式使用 Jackson 2；禁止使用 Jackson 3 的便捷门面。 -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-core</artifactId>
            <version>${mcp.version}</version>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
            <version>${mcp.version}</version>
        </dependency>

        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
            <version>${mybatis.version}</version>
        </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.java-diff-utils</groupId>
      <artifactId>java-diff-utils</artifactId>
      <version>4.17</version>
    </dependency>

        <!-- Provider 与 MCP 网络适配器共用 OkHttp。JVM 产物显式依赖该组件，因为通用坐标仅提供元数据。 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
            <version>${okhttp.version}</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-sse</artifactId>
            <version>${okhttp.version}</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.okio</groupId>
            <artifactId>okio-jvm</artifactId>
            <version>${okio.version}</version>
        </dependency>

        <!-- MCP 传输直接使用 Reactor 类型，固定当前正式版而不依赖 SDK 的传递版本。 -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <version>${reactor.version}</version>
        </dependency>

        <!-- 结构化日志 API 与生产 Logback Provider 都是运行时直接边界。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- 工具参数使用依赖探测已验证的成熟 2020-12 校验器；最终版本不再保留自研 Schema 实现。 -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${networknt.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver3</artifactId>
            <version>${mockwebserver.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.code-intelligence</groupId>
            <artifactId>jazzer-junit</artifactId>
            <version>${jazzer.version}</version>
            <scope>test</scope>
            <exclusions>
                <!-- Jazzer 0.30 声明依赖 JUnit 5.9；Ja 统一使用 JUnit 6.1 平台。 -->
                <exclusion>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter-params</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>junit-platform-launcher</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5-api</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5-engine</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <directory>${ja.app-server.build.directory}</directory>
        <finalName>${project.artifactId}</finalName>
        <resources>
            <!-- 生产资源保持逐字复制；只有版本资源允许 Maven 展开 project.version。 -->
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>${project.basedir}/src/main/version</directory>
                <filtering>true</filtering>
                <includes>
                    <include>ja-build.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <configuration>
                    <testSourceDirectories>
                        <testSourceDirectory>${project.basedir}/src/test/java</testSourceDirectory>
                        <testSourceDirectory>${project.basedir}/src/test/support/java</testSourceDirectory>
                    </testSourceDirectories>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <useFile>false</useFile>
                    <failIfNoTests>false</failIfNoTests>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${ja.main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.noear</groupId>
                <artifactId>solon-maven-plugin</artifactId>
                <version>${solon.version}</version>
                <!-- 中性父工程不会继承 Solon 生命周期绑定。 -->
                <executions><execution><phase>package</phase><goals><goal>repackage</goal></goals></execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven-resources-plugin.version}</version>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <propertiesEncoding>${project.build.sourceEncoding}</propertiesEncoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <configuration>
                    <failOnWarning>true</failOnWarning>
                    <ignoreNonCompile>true</ignoreNonCompile>
                    <!-- 下列扩展与测试 Engine 通过 ServiceLoader 发现，字节码分析无法观察其入口。 -->
                    <usedDependencies>
                        <usedDependency>org.noear:solon-java25</usedDependency>
                        <usedDependency>org.noear:solon-config-yaml</usedDependency>
                        <usedDependency>org.noear:solon-logging-logback-jakarta</usedDependency>
                        <usedDependency>org.junit.jupiter:junit-jupiter-engine</usedDependency>
                        <usedDependency>com.tngtech.archunit:archunit-junit5-engine</usedDependency>
                    </usedDependencies>
                    <!-- Logback 同时是生产 Provider 和日志配置测试 API，不应被误判为仅测试依赖。 -->
                    <ignoredNonTestScopedDependencies>
                        <ignoredNonTestScopedDependency>ch.qos.logback:logback-classic</ignoredNonTestScopedDependency>
                        <ignoredNonTestScopedDependency>ch.qos.logback:logback-core</ignoredNonTestScopedDependency>
                    </ignoredNonTestScopedDependencies>
                </configuration>
                <executions>
                    <execution>
                        <id>dependency-usage-gate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>analyze-only</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <dependencies>
                <dependency>
                    <groupId>org.noear</groupId>
                    <artifactId>solon-aot</artifactId>
                    <version>${solon.version}</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.noear</groupId>
                        <artifactId>solon-maven-plugin</artifactId>
                        <version>${solon.version}</version>
                        <executions>
                            <execution>
                                <id>generate-native-aot-metadata</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>${maven-resources-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>replace-solon-deprecated-native-arguments</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <!-- Solon 4.1.0 AOT 仍会生成两个已弃用参数。AOT 完成后、Native 编译前恢复 Ja 自有的最小元数据。 -->
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <changeDetection>always</changeDetection>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/src/native/resources</directory>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native-maven-plugin.version}</version>
                        <configuration>
                            <imageName>${project.artifactId}</imageName>
                            <mainClass>${ja.main.class}</mainClass>
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                            <!-- native-image 会先解析 NATIVE_IMAGE_OPTIONS，再展开 classpath 内的
                                 metadata properties；借此让 Ja 与第三方已审计实验元数据都在显式授权下加载。 -->
                            <environment>
                                <NATIVE_IMAGE_OPTIONS>-H:+UnlockExperimentalVMOptions</NATIVE_IMAGE_OPTIONS>
                            </environment>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                                <!-- GraalVM 25 要求显式确认实验选项。依赖的 Native metadata
                                     会在命令行参数之后解析，因此必须让确认开关覆盖完整元数据加载阶段；
                                     Native 输出仍会逐项列出实际启用的实验选项供门禁审计。 -->
                                <!-- Windows 凭据句柄的生命周期可能超过创建它的回调；有界清理期间，Native Image 必须保留共享 Arena 语义。 -->
                                <buildArg>-H:+SharedArenaSupport</buildArg>
                            </buildArgs>
                            <metadataRepository>
                                <enabled>true</enabled>
                            </metadataRepository>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native-image</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
