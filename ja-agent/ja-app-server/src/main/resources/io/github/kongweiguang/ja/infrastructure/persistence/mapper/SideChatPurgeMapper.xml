<mapper namespace="io.github.kongweiguang.ja.infrastructure.persistence.mapper.SideChatPurgeMapper">
    <!-- 下方每个 Mapper 方法都只包含一条 SQL 语句。Java 调用方会在首次删除前快照全部 ID，避免删除开始后重新展开 ja_conversation_lineage。 -->
    <!-- OGNL 的 size 属性由 ListPropertyAccessor 直接调用 List 接口；使用 size() 会反射
         冻结集合的 JDK 内部实现，在 Native Image 闭世界中引入不必要的反射依赖。 -->

    <resultMap id="sideChatCloseReceiptRow" type="io.github.kongweiguang.ja.infrastructure.persistence.mapper.TaskRecords$SideChatCloseReceiptRow">
        <constructor>
            <idArg column="root_thread_id" javaType="string"/>
            <arg column="workspace_id" javaType="string"/>
            <arg column="owner_root_thread_id" javaType="string"/>
            <arg column="closed_thread_count" javaType="int"/>
            <arg column="closed_at_ms" javaType="long"/>
        </constructor>
    </resultMap>
    <resultMap id="sideChatCloseMemberRow" type="io.github.kongweiguang.ja.infrastructure.persistence.mapper.TaskRecords$SideChatCloseMemberRow">
        <constructor>
            <idArg column="member_ordinal" javaType="int"/>
            <arg column="thread_id" javaType="string"/>
        </constructor>
    </resultMap>

    <select id="countClosingRoot" resultType="int">
        SELECT COUNT(*)
        FROM ja_conversation_thread c
        JOIN ja_conversation_thread t ON t.thread_id=c.thread_id
        WHERE c.thread_id=#{rootThreadId}
        AND c.temporary_lifecycle_state='CLOSING'
        AND t.deleted_at_ms IS NULL
        AND EXISTS (
        SELECT 1 FROM ja_conversation_lineage l
        WHERE l.child_thread_id=c.thread_id
        AND l.task_kind='SIDE_TASK' AND l.lifecycle='INDEPENDENT'
        )
    </select>

    <select id="selectCloseReceipt" resultMap="sideChatCloseReceiptRow">
        SELECT root_thread_id,workspace_id,owner_root_thread_id,closed_thread_count,closed_at_ms
        FROM ja_task_side_chat_close_receipt WHERE root_thread_id=#{rootThreadId}
    </select>
    <select id="selectCloseReceiptMembers" resultMap="sideChatCloseMemberRow">
        SELECT member_ordinal,thread_id FROM ja_task_side_chat_close_member
        WHERE root_thread_id=#{rootThreadId} ORDER BY member_ordinal
    </select>
    <select id="selectPurgeWorkspaceId" resultType="string">
        SELECT workspace_id FROM ja_conversation_thread
        WHERE thread_id=#{rootThreadId} AND temporary_lifecycle_state='CLOSING'
    </select>
    <select id="countPurgeThreadsOutsideWorkspace" resultType="int">
        WITH RECURSIVE tree(thread_id) AS (
        SELECT thread_id FROM ja_conversation_thread
        WHERE thread_id=#{rootThreadId} AND temporary_lifecycle_state='CLOSING'
        UNION ALL
        SELECT l.child_thread_id FROM ja_conversation_lineage l JOIN tree t ON l.parent_thread_id=t.thread_id
        )
        SELECT COUNT(*) FROM tree AS t1
        JOIN ja_conversation_thread AS t2 ON t2.thread_id=t1.thread_id
        WHERE t2.workspace_id&lt;&gt;#{workspaceId}
    </select>
    <insert id="insertCloseReceipt">
        INSERT INTO ja_task_side_chat_close_receipt(
            root_thread_id,workspace_id,owner_root_thread_id,closed_thread_count,closed_at_ms
        ) VALUES (
            #{receipt.rootThreadId},#{receipt.workspaceId},#{receipt.ownerRootThreadId},
            #{receipt.closedThreadCount},#{receipt.closedAtMs}
        )
    </insert>
    <insert id="insertCloseReceiptMembers">
        INSERT INTO ja_task_side_chat_close_member(root_thread_id,member_ordinal,thread_id)
        VALUES
        <foreach item="member" collection="members" separator=",">
            (#{member.rootThreadId},#{member.memberOrdinal},#{member.threadId})
        </foreach>
    </insert>
    <delete id="deleteWorkspaceCloseReceiptMembers">
        DELETE FROM ja_task_side_chat_close_member
        WHERE root_thread_id IN (
            SELECT root_thread_id FROM ja_task_side_chat_close_receipt WHERE workspace_id=#{workspaceId}
        )
    </delete>
    <delete id="deleteWorkspaceCloseReceipts">
        DELETE FROM ja_task_side_chat_close_receipt WHERE workspace_id=#{workspaceId}
    </delete>

    <select id="selectPurgeThreadIds" resultType="string">
        WITH RECURSIVE tree(thread_id,depth) AS (
        SELECT thread_id,0
        FROM ja_conversation_thread
        WHERE thread_id=#{rootThreadId} AND temporary_lifecycle_state='CLOSING'
        UNION ALL
        SELECT l.child_thread_id,t.depth+1
        FROM ja_conversation_lineage l JOIN tree t ON l.parent_thread_id=t.thread_id
        )
        SELECT thread_id FROM tree ORDER BY depth,thread_id
    </select>

    <update id="markPurgeThreadsClosing">
        UPDATE ja_conversation_thread SET temporary_lifecycle_state='CLOSING' WHERE 0
        <if test="threadIds != null and threadIds.size > 0">
            OR thread_id IN <foreach item="threadId" collection="threadIds" open="(" separator="," close=")">#{threadId}</foreach>
        </if>
    </update>
    <select id="countNonTerminalTurns" resultType="int">
        SELECT (SELECT COUNT(*) FROM ja_conversation_turn WHERE state NOT IN('COMPLETED','FAILED','CANCELLED')
        AND thread_id IN <foreach item="threadId" collection="threadIds" open="(" separator="," close=")">#{threadId}</foreach>)
        +(SELECT COUNT(*) FROM agent_execution WHERE tenant_id='ja.local' AND user_id='user_local'
        AND state NOT IN('COMPLETED','FAILED','CANCELLED') AND thread_id IN
        <foreach item="threadId" collection="threadIds" open="(" separator="," close=")">#{threadId}</foreach>)
    </select>
