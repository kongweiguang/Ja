        </if>
        UNION
        SELECT attachment_id FROM ja_thread_fork_attachment
        WHERE 0
        <if test="threadIds != null and threadIds.size > 0">
            OR thread_id IN
            <foreach item="threadId" collection="threadIds" open="(" separator="," close=")">#{threadId}</foreach>
        </if>
        ORDER BY attachment_id
    </select>

    <update id="discardPurgeAttachments">
        UPDATE ja_attachment
        SET status='DISCARDED', discarded_at_ms=#{discardedAt,typeHandler=io.github.kongweiguang.ja.infrastructure.persistence.mapper.EpochMillisStringTypeHandler,jdbcType=BIGINT}, blob_sha256=NULL, bound_at_ms=NULL
        WHERE 0
        <if test="attachmentIds != null and attachmentIds.size > 0">
            OR (
            status IN ('DRAFT','BOUND')
            AND attachment_id IN
            <foreach item="attachmentId" collection="attachmentIds" open="(" separator="," close=")">#{attachmentId}
            </foreach>
            AND NOT EXISTS (
            SELECT 1 FROM ja_message_attachment ma WHERE ma.attachment_id=ja_attachment.attachment_id
            )
            AND NOT EXISTS (
            SELECT 1 FROM ja_turn_input_attachment pia WHERE pia.attachment_id=ja_attachment.attachment_id
            )
            AND NOT EXISTS (
            SELECT 1 FROM ja_tool_result_attachment tra WHERE tra.attachment_id=ja_attachment.attachment_id
            )
            AND NOT EXISTS (
            SELECT 1
            FROM ja_task_context_seed s, json_each(s.references_json) ref
            WHERE json_extract(ref.value,'$.kind')='attachment'
            AND json_extract(ref.value,'$.attachmentId')=ja_attachment.attachment_id
            )
            )
        </if>
    </update>

