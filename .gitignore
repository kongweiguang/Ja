# Ja 分发时包含锁文件、许可证、源码资源和 Native Image 元数据。
# 构建产物和本机状态不纳入源码，以确保全新检出后仍可复现构建。
# @author kongweiguang
# SPDX-License-Identifier: GPL-3.0-or-later

# 操作系统和本地编辑器状态
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*.swn

# Node.js / Vite / pnpm 生成物
node_modules/
.pnpm-store/
.vite/
dist/
dist-ssr/
coverage/
*.local
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*

# 测试与运行日志、结果均可重新生成，不属于源码样例。
/logs/
/.tmp/
/.tmp-*/
/test-results/
/playwright-report/
/blob-report/

# 保留包锁文件，确保桌面端构建可复现。
!pnpm-lock.yaml

# Rust / Tauri 构建产物
target/
target-*/
/.codex-target/
.cargo/target-*/
*.rlib
*.rmeta
*.pdb

# Java / Maven / GraalVM 构建产物
ja-agent/ja-app-server/target/
ja-agent/ja-app-server/build/
ja-agent/ja-app-server/native-image/
ja-agent/ja-app-server/.cifuzz-corpus/
.native-image/
*.class

# Python 合同校验器和参考校验器的字节码均可重新生成。
__pycache__/
*.py[cod]

# 原生桌面打包产物；发布任务生成的签名产物清单另行纳入版本控制。
artifacts/
bundle/
release/
# @author kongweiguang
# 保留已纳入版本控制的发布验证脚本，继续忽略生成的发布产物。
!scripts/release/
!scripts/release/sbom/
!scripts/release/sbom/*.ps1
!scripts/release/sbom/*.md
*.appimage
*.dmg
*.msi
*.nsis.zip
*.deb
*.rpm
*.exe

# IDE 元数据；保留共享的 VS Code 扩展推荐配置。
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
*.suo
*.user
*.userosscache
*.sln.docstates

# 先前的 Windows 环境变量展开可能生成此字面名称的本机缓存镜像。
# 将其排除于 Git 和任务轮次基线之外，但不删除用户可恢复的文件。
/%SystemDrive%/

# 本地配置与凭据；保留用户可见的模板。
.secrets/
secrets/
*.secret
credentials.*
*.pem
*.key
*.p12
*.pfx
*.keystore
*.mobileprovision

# 将许可证文件、源码和原生构建元数据保留在版本控制中。
!LICENSE
!ja-agent/ja-app-server/src/main/resources/META-INF/native-image/
!ja-agent/ja-app-server/src/main/resources/META-INF/native-image/**
!Cargo.lock
/.codegraph

.soloncode/

# BEGIN UPDENG
# @author kongweiguang
/.agents/
/.codex/
/.updeng/
/AGENTS.md
.env
.env.*
!.env.example
# END UPDENG

# Java 多模块构建的产物由各模块分别管理。
ja-agent/**/target/
ja-agent/**/target-*/
